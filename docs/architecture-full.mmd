flowchart TB
    subgraph CLIENTS["客户端"]
        FE["Vue3 前端（用户端 + 管理端）<br/>Pinia + Element Plus + axios + SSE"]
        DEV["外部开发者<br/>Bearer sk- API Key"]
    end

    subgraph APP["Spring Boot 3（API / Worker 一体，可多实例）"]
        subgraph API["API 受理层"]
            IN["Auth(Redis Token) / ApiKey / RateLimit(Redis Lua)"]
            CTRL["Video / ApiVideo / Admin / Callback Controller"]
            GATE["ModelAccessService<br/>模型开放闸门"]
            SUB["VideoSubmitService<br/>UI / 开放 API / 画布 / 流水线共用"]
            ACCEPT["受理短事务<br/>video_task + wallet freeze<br/>generation_attempt + GENERATION_SUBMIT"]
            RECH["RechargeService + ChannelRegistry"]
            STREAM["TaskStreamManager<br/>AFTER_COMMIT → SSE"]
            WEBHOOK["WebhookDispatcher<br/>HMAC-SHA256 + 退避重试"]
        end

        subgraph RUNTIME["统一分布式 Worker runtime"]
            WAKE["job-available 合并唤醒<br/>+ 30s 带抖动 MySQL 扫描"]
            RT["AsyncJobWorkerRuntime<br/>先取 permit 再单张 claim<br/>有界线程池 + heartbeat"]
            LEASE["MySQL NOW() + FOR UPDATE SKIP LOCKED<br/>稳定 owner · 随机 token · 单调 generation"]
            H1["GENERATION_SUBMIT<br/>供应商提交"]
            H2["TASK_POLL<br/>供应商状态查询"]
            H3["TASK_FINALIZE<br/>下载 / OSS / 终态结算"]
            H4["TASK_RETRY<br/>原子 stage 新 attempt"]
            H5["CANVAS_NODE_SUBMIT"]
            H6["PIPELINE_NODE_SUBMIT"]
            H7["ORDER_CLOSE"]
            FINAL["按 handler 最终短事务<br/>renew → 当前业务身份校验 → fenced CAS<br/>→ complete；生成成功同时 cost/settle<br/>complete=0 整体回滚"]
            POLLER["VideoTaskPoller<br/>只从 Writer 扫到期任务并幂等入 TASK_POLL"]
            RECON["TaskReconcileTask<br/>低频补漏 / 账务补偿"]
        end

        subgraph ENGINE["提供方策略层"]
            REG["VideoEngineRegistry"]
            SE["SeedanceEngine<br/>POLL · 2s/5s/30s"]
            CE["ComfyUiEngine<br/>CALLBACK + 60s poll fallback"]
            SCHED["ComfyUiNodeScheduler<br/>least-queue / round-robin"]
            WB["WorkflowBuilder<br/>MiniMax-H3 · Z-Image · Qwen-Image"]
            UNKNOWN["SUBMIT_UNKNOWN / RECOVERY_REQUIRED<br/>无法证明未接单时停放并告警<br/>不盲目重投"]
        end
    end

    subgraph DATA["基础设施（异步真相为 MySQL）"]
        DB[("MySQL · Flyway V31<br/>video_task / generation_attempt / async_job<br/>wallet / balance_transaction / cost_record<br/>recharge_order / api_key / model_access")]
        REDIS[("Redis<br/>登录态 / 限流 / 可重建缓存<br/>作业链路仅 job-available 门铃")]
        OSS[("阿里云 OSS<br/>参考素材 + 生成产物")]
    end

    subgraph PROVIDER["外部服务"]
        SD["Seedance 云端 API（火山方舟）"]
        NG["nginx（X-Comfy-Token 校验）"]
        CF["ComfyUI 多实例 GPU 集群"]
        ALI["支付宝 / 微信支付网关"]
    end

    FE -->|"HTTP + SSE"| IN
    DEV -->|"/api/v1/**"| IN
    IN --> CTRL
    CTRL --> GATE
    GATE --> SUB
    SUB --> ACCEPT
    ACCEPT --> DB
    ACCEPT -->|"commit 后立即返回稳定 taskId"| CTRL
    CTRL --> FE
    CTRL --> DEV
    ACCEPT -.->|"afterCommit"| REDIS

    REDIS -.->|"门铃，可丢失"| WAKE
    DB -.->|"兜底扫描 Writer"| WAKE
    WAKE --> RT
    RT --> LEASE
    LEASE --> DB
    RT --> H1
    RT --> H2
    RT --> H3
    RT --> H4
    RT --> H5
    RT --> H6
    RT --> H7

    H1 -->|"事务外 provider HTTP"| REG
    H2 -->|"事务外 provider HTTP"| REG
    H3 -->|"事务外下载"| REG
    H3 -->|"事务外上传"| OSS
    REG --> SE
    REG --> CE
    SE --> SD
    CE --> SCHED
    CE --> WB
    SCHED --> NG
    NG --> CF
    H1 -.->|"超时 / 断连 / 5xx / 空 ID"| UNKNOWN
    UNKNOWN --> DB

    POLLER -->|"Seedance 2/5/30s<br/>ComfyUI 60s fallback"| DB
    CF -.->|"完成 callback"| CTRL
    CTRL -->|"身份 CAS + 幂等入队 FINALIZE"| DB
    RECON --> DB
    H1 --> FINAL
    H2 --> FINAL
    H3 --> FINAL
    H4 --> FINAL
    H5 --> FINAL
    H6 --> FINAL
    H7 --> FINAL
    FINAL --> DB

    CTRL --> RECH
    RECH --> ALI
    RECH --> DB
    DB -.->|"终态 AFTER_COMMIT"| STREAM
    STREAM -.-> FE
    STREAM -.->|"跨实例 task-status"| REDIS
    STREAM -.-> WEBHOOK
    WEBHOOK -.-> DEV

    style API fill:#fff7e8,stroke:#e0a83c
    style RUNTIME fill:#eef4ff,stroke:#6b8ef0
    style ENGINE fill:#eefaf1,stroke:#4fbf6a
    style UNKNOWN fill:#fff0f0,stroke:#d95c5c
