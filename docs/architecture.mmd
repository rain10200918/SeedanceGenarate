# ============================================================
# 图 3 · async_job 多实例故障接管
# ============================================================

flowchart LR
    subgraph WA["Worker 实例 A"]
        RA["AsyncJobWorkerRuntime"]
        PA["先取本机 permit<br/>再单张 claim"]
        RA --> PA
    end

    subgraph WB["Worker 实例 B"]
        RB["AsyncJobWorkerRuntime"]
        PB["先取本机 permit<br/>再单张 claim"]
        RB --> PB
    end

    DB[("MySQL V31 · async_job<br/>READY / RUNNING / SUCCEEDED / DEAD<br/>lease_token + lease_generation")]
    REDIS[("Redis<br/>job-available 门铃")]
    HANDLERS["7 类 AsyncJobHandler<br/>GENERATION_SUBMIT · TASK_POLL · TASK_FINALIZE<br/>TASK_RETRY · CANVAS_NODE_SUBMIT<br/>PIPELINE_NODE_SUBMIT · ORDER_CLOSE"]
    IO["事务外 I/O<br/>Provider HTTP / 下载 / OSS"]
    FINAL["按 handler 最终短事务<br/>renew(token+generation)<br/>→ 当前业务身份校验 → fenced CAS<br/>→ complete；生成成功同时 cost/settle"]

    REDIS -.-> RA
    REDIS -.-> RB
    DB -.->|"30s 扫描兜底"| RA
    DB -.->|"30s 扫描兜底"| RB
    PA -->|"FOR UPDATE SKIP LOCKED<br/>MySQL NOW()"| DB
    PB -->|"FOR UPDATE SKIP LOCKED<br/>MySQL NOW()"| DB
    DB -->|"唯一 token + generation 租约"| HANDLERS
    HANDLERS --> IO
    IO --> FINAL
    FINAL --> DB
    DB -.->|"租约过期可接管；generation 变化<br/>拒绝旧 Worker 迟到回写"| HANDLERS

# ============================================================
# 图 4 · 一次生成的任务生命周期
# ============================================================

sequenceDiagram
    autonumber
    participant U as 前端 / 外部开发者
    participant A as API / VideoSubmitService
    participant DB as MySQL V31
    participant R as Redis 门铃
    participant W as AsyncJobWorkerRuntime
    participant E as VideoEngine / Provider
    participant P as Poller / Callback / Reconcile
    participant O as OSS
    participant S as SSE

    U->>A: POST 生成请求
    A->>DB: 短事务：task + freeze + attempt + GENERATION_SUBMIT
    DB-->>A: commit
    A-->>R: afterCommit job-available（只唤醒）
    A-->>U: 立即返回稳定 taskId

    R-->>W: 唤醒（丢失由 30s MySQL 扫描恢复）
    W->>DB: claim GENERATION_SUBMIT（token + generation）
    W->>DB: attempt PENDING → SUBMITTING
    W->>E: 事务外 provider HTTP
    alt providerTaskId 已确认
        W->>DB: fenced 短事务：attempt SUBMITTED + task RUNNING + complete
    else 可证明未接单
        W->>DB: fenced failAndRetry（SAFE_RETRY）
    else 结果无法确认
        W->>DB: SUBMIT_UNKNOWN / RECOVERY_REQUIRED + complete
        Note over W,DB: 保持公开 PROCESSING、冻结和槽位；禁止盲目重投
    end

    par ComfyUI 完成路径
        E-->>P: callback（主路径）
        P->>DB: 身份 CAS + 幂等入队 TASK_FINALIZE
    and ComfyUI 查询兜底
        loop 每 60s 到期
            P->>DB: 幂等入队 TASK_POLL
        end
    and Seedance 轮询
        loop 2s / 5s / 30s 退避
            P->>DB: 幂等入队 TASK_POLL
        end
    end

    W->>DB: claim TASK_POLL / TASK_FINALIZE
    W->>E: 事务外 poll / 下载
    W->>O: 事务外上传生成产物
    W->>DB: 最终短事务：renew + current attempt 身份校验
    W->>DB: fenced CAS SUCCESS + cost_record + 钱包结算 + complete
    DB-->>S: AFTER_COMMIT 终态事件
    S-->>U: SSE {taskId, status}
