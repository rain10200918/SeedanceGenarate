# ============================================================
# 图 1 · 系统总览（组件视图）
# ============================================================

flowchart TB
    subgraph CLIENT["客户端"]
        FE["Vue3 前端<br/>Pinia + Element Plus + axios + SSE"]
        DEV["外部开发者<br/>Bearer sk- API Key"]
    end

    subgraph API["Spring Boot API 实例（可多实例）"]
        IN["Auth / ApiKey / RateLimit"]
        CTRL["Video / ApiVideo / Admin / Callback Controller"]
        SUB["VideoSubmitService<br/>校验 + 受理编排"]
        TX["MySQL 短事务<br/>task + freeze + attempt<br/>+ GENERATION_SUBMIT"]
        SSE["TaskStreamManager<br/>终态 SSE"]
    end

    subgraph WORKER["分布式 Worker（可多实例）"]
        RT["AsyncJobWorkerRuntime<br/>有界执行池 + heartbeat<br/>token + generation fencing"]
        H1["GENERATION_SUBMIT"]
        H2["TASK_POLL"]
        H3["TASK_FINALIZE"]
        H4["TASK_RETRY"]
        H5["CANVAS_NODE_SUBMIT"]
        H6["PIPELINE_NODE_SUBMIT"]
        H7["ORDER_CLOSE"]
        POLLER["VideoTaskPoller<br/>只扫描到期任务并幂等入队"]
        RECON["TaskReconcileTask<br/>低频补漏"]
    end

    subgraph DATA["持久化与通知"]
        DB[("MySQL · Flyway V31<br/>video_task / generation_attempt / async_job<br/>wallet / cost_record")]
        BELL[("Redis job-available<br/>仅作唤醒门铃，可丢失")]
        OSS[("阿里云 OSS<br/>参考素材 + 生成产物")]
    end

    subgraph PROVIDERS["生成提供方"]
        REG["VideoEngineRegistry"]
        SD["Seedance API<br/>2s / 5s / 30s 退避轮询"]
        CF["ComfyUI 多实例<br/>callback + 60s poll fallback"]
    end

    FE -->|"HTTP / SSE"| IN
    DEV -->|"HTTP API"| IN
    IN --> CTRL
    CTRL --> SUB
    SUB --> TX
    TX --> DB
    TX -->|"提交后立即返回稳定 taskId"| CTRL
    CTRL --> FE
    CTRL --> DEV
    TX -.->|"afterCommit"| BELL
    BELL -.->|"即时唤醒"| RT
    DB -.->|"30s 带抖动扫描兜底"| RT
    RT --> H1
    RT --> H2
    RT --> H3
    RT --> H4
    RT --> H5
    RT --> H6
    RT --> H7
    H1 --> REG
    H2 --> REG
    H3 -->|"事务外下载"| REG
    H3 -->|"事务外上传"| OSS
    REG --> SD
    REG --> CF
    CF -.->|"完成回调"| CTRL
    POLLER -->|"幂等 enqueue TASK_POLL"| DB
    RECON --> DB
    RT -->|"最终短事务：renew + 业务身份 CAS + complete<br/>生成成功同时 cost / settle"| DB
    DB -.->|"AFTER_COMMIT 终态事件"| SSE
    SSE -.-> FE

